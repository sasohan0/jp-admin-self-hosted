# Copy production values into a local `.env.failover` file. Never commit it.
# This launcher refuses legacy mode, the wrong cohort, and the wrong Discord bot.
LOCAL_FAILOVER=true
LOCAL_FAILOVER_HEALTH_URL=https://your-render-service.onrender.com/health
LOCAL_FAILOVER_EXPECTED_COHORT=YOUR-COHORT
LOCAL_FAILOVER_BOT_ID=YOUR_PUBLIC_DISCORD_APPLICATION_ID
LOCAL_FAILOVER_PORT=3100

# Copy the same non-secret cohort configuration and private credentials used by
# the isolated production service. Do not paste real values into this example.
DISCORD_TOKEN=
COHORT_NAME=
COHORT_GUILD_ID=
COHORT_API_URL=
COHORT_API_KEY=
COHORT_SUPERVISOR_IDS=
COHORT_TIMEZONE=Asia/Dhaka
COHORT_CHANNELS_JSON={}
BOT_ACTIVE_WINDOW=04:50-23:30
BOT_ACTIVE_TIMEZONE=Asia/Dhaka
