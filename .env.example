# Copy this file to ".env" for local testing.
# On Render/Discloud, set these in the dashboard instead - never commit .env!
DISCORD_TOKEN=paste_your_NEW_reset_token_here

# Easiest mentor-owned deployment. Render's Blueprint sets these. The bot
# discovers the server, supervisor, and channels after an administrator runs
# !setup; the signed Discord capsule contains no secrets.
# JP_INSTALLER_MODE=true
# COHORT_API_URL=https://script.google.com/macros/s/XXXX/exec
# COHORT_API_KEY=a_unique_random_value_of_at_least_32_characters
# COHORT_TIMEZONE=Asia/Dhaka
# Required only for the optional pre-entry intake portal. The client ID is
# public; the client secret and session secret are passwords.
# DISCORD_CLIENT_ID=123456789012345678
# DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret
# INTAKE_SESSION_SECRET=a_separate_random_value_of_at_least_32_characters
# INTAKE_PUBLIC_URL=https://your-unified-service.onrender.com
EJP13_API_URL=https://script.google.com/macros/s/XXXX/exec
EJP13_API_KEY=your_apps_script_secret_key

# Unified service mode (recommended; maximum three enabled cohorts).
# The JSON contains no backend secrets. Each entry references separate Render
# environment variables for its Apps Script URL/key.
# COHORT_REGISTRY_JSON=[{"key":"ejp13","name":"EJP-13","guildId":"123456789012345678","supervisorIds":["111111111111111111"],"channels":{}},{"key":"stride","name":"STRIDE","guildId":"223456789012345678","supervisorIds":["111111111111111111"],"channels":{}}]
# EJP13_API_URL=https://script.google.com/macros/s/XXXX/exec
# EJP13_API_KEY=private_backend_key
# STRIDE_API_URL=https://script.google.com/macros/s/YYYY/exec
# STRIDE_API_KEY=private_backend_key
# FORWARDER_HUB_GUILD_ID=123456789012345678
# Fallback until the protected control backend's !backend schedule is loaded.
# BOT_ACTIVE_WINDOW=04:50-23:30
# BOT_ACTIVE_TIMEZONE=Asia/Dhaka
# COHORT_CONTROL_KEY=stride
# RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv-example?key=private_deploy_hook

# Separate Render service / separate Discord bot application:
# Setting any COHORT_* identity value activates isolated mode and loads ONLY
# this cohort. Do not mix these with another cohort in the same Render service.
# DISCORD_TOKEN=the_token_for_this_new_bot_application
# COHORT_NAME=EJP-14
# COHORT_GUILD_ID=123456789012345678
# COHORT_API_URL=https://script.google.com/macros/s/XXXX/exec
# COHORT_API_KEY=a_unique_apps_script_secret
# COHORT_SUPERVISOR_IDS=688079587728556043,871623531039981598
# COHORT_TIMEZONE=Asia/Dhaka
# COHORT_CHANNELS_JSON={}
# GROQ_API_KEY=your_groq_key
